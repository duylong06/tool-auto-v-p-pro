# ============================================
# CHON NHA CUNG CAP LLM: "gemini" hoac "claude"
# ============================================
LLM_PROVIDER=gemini

# --- Gemini (MIEN PHI, khong can the tin dung) ---
# Lay key tai: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-3.6-flash

# --- Claude (TINH PHI - chi dung khi da nap credit) ---
# ANTHROPIC_API_KEY=your_anthropic_key_here
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Google OAuth (cho Gmail API) ---
# Lay tai: https://console.cloud.google.com/ -> APIs & Services -> Credentials
# Redirect URI phai la: http://localhost:3001/oauth2callback
GOOGLE_CLIENT_ID=your_client_id_here
GOOGLE_CLIENT_SECRET=your_client_secret_here

# --- Server ---
PORT=3000